# rolepod CLI contract snapshot -- codex -- taken at 0.153.0 on 2026-09-14 (this line is informational, not diffed)
agents_keys: default_subagent_model default_subagent_reasoning_effort enabled interrupt_message max_concurrent_threads_per_session
collab_tools: close_agent followup_task interrupt_agent list_agents resume_agent send_input send_message spawn_agent wait_agent
effort_levels: high low max medium minimal ultra xhigh
hook_events: Interrupt PermissionRequest PostCompact PostToolUse PreCompact PreToolUse SessionEnd SessionStart Stop SubagentStart SubagentStop UserPromptSubmit
model_ids: gpt-4.1 gpt-5.2 gpt-5.2-codex gpt-5.3-codex gpt-5.4 gpt-5.4-mini gpt-5.5 gpt-5.6 gpt-5.6-luna gpt-5.6-pro gpt-5.6-sol gpt-5.6-terra
spawn_params: agent_type fork_turns model nickname reasoning_effort task_name
