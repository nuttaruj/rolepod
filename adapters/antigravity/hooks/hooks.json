{
  "rolepod": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "hooks/session-start.sh",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "hooks/model-log.sh",
        "timeout": 3
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/pre-tool.sh",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "hooks/stop-unlock.sh",
        "timeout": 3
      }
    ]
  }
}
