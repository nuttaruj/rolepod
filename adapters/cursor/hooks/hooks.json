{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./scripts/project-context-loader.sh",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": "./scripts/precommit-gate.sh",
        "matcher": "(^|[;&|]|\\s)git(\\s|$)",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "./scripts/stop-unlock.sh",
        "timeout": 3
      }
    ]
  }
}
