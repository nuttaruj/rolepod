{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./scripts/project-context-loader.sh",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./scripts/sweep-nudge.sh",
        "timeout": 3
      }
    ],
    "preToolUse": [
      {
        "command": "./scripts/gate-reminder.sh",
        "matcher": "Write|Edit|MultiEdit",
        "timeout": 3
      },
      {
        "command": "./scripts/sweep-nudge.sh",
        "matcher": "Write|Edit|MultiEdit",
        "timeout": 3
      },
      {
        "command": "./scripts/dispatch-log.sh",
        "matcher": "Task",
        "timeout": 3
      }
    ],
    "postToolUse": [
      {
        "command": "./scripts/gate-reminder.sh",
        "matcher": "Write|Edit|MultiEdit",
        "timeout": 3
      },
      {
        "command": "./scripts/sweep-nudge.sh",
        "matcher": "Read|Grep|Glob|WebFetch|WebSearch",
        "timeout": 3
      }
    ],
    "afterShellExecution": [
      {
        "command": "./scripts/sweep-nudge.sh",
        "timeout": 3
      }
    ],
    "beforeShellExecution": [
      {
        "command": "./scripts/precommit-gate.sh",
        "matcher": "(^|[;&|]|\\s)git(\\s|$)",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "./scripts/stop-unlock.sh",
        "timeout": 3
      }
    ]
  }
}
