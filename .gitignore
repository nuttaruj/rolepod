# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Backups + installer leftovers
*.bak
*.bak.*
*.legacy-*
*.rolepod-bak.*

# Logs / run output
*.log

# Local-only
.claude/
brief/
specs/
contract.md
session-env/
shell-snapshots/
file-history/
HANDOFF.md
.gitnexus

# Build output
build/rendered/

# Isolated worktrees. using-rolepod's concurrent-session rule tells a Lead to
# spawn `.worktrees/<task>` before editing a shared file, so the path the
# doctrine recommends must not dirty `git status` for everyone who follows it.
.worktrees/

# Python bytecode
__pycache__/
*.pyc

# runtime session markers (session-lifecycle hook)
.rolepod/
.rolepod-mcp/
__pycache__/

# rolepod working docs — specs / plans / cohesion contracts / maps / hand-offs are
# private by default (v2.80.0): never committed. A repo that wants them tracked
# creates .rolepod/docs-tracked and removes this line.
docs/rolepod/

# Planning docs of this repo's own past work (v2.89.0) — the repo ships product
# files and the docs the shipped payload links to; design plans stay local.
docs/plans/
docs/adrs/
docs/handoffs/
